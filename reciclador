<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Portal del reciclador · Nexia</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:#17231d;background:#f3f7f5;--g:#128a58;--g2:#0b6c44;--line:#dce7e1;--muted:#6b7771;--panel:#fff}*{box-sizing:border-box}body{margin:0;background:#f3f7f5}.top{height:64px;background:#10271d;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 20px}.brand{font-weight:900;letter-spacing:.04em}.brand b{color:#49dda0}.layout{display:grid;grid-template-columns:360px 1fr;min-height:calc(100vh - 64px)}.left{border-right:1px solid var(--line);background:#fff;padding:16px;overflow:auto}.right{padding:20px;overflow:auto}.toolbar{display:flex;gap:8px;align-items:center;margin-bottom:14px}.toolbar button,button{border:0;border-radius:12px;padding:11px 14px;background:var(--g);color:white;font-weight:800;cursor:pointer}.toolbar button.secondary,.secondary{background:#edf5f1;color:#245440}.item{border:1px solid var(--line);border-radius:15px;padding:13px;margin-bottom:10px;cursor:pointer;background:white}.item.active{border-color:#32a975;box-shadow:0 0 0 3px rgba(18,138,88,.08)}.item h3{font-size:1rem;margin:0 0 5px}.small{font-size:.82rem;color:var(--muted);line-height:1.45}.badge{display:inline-block;border-radius:999px;padding:4px 8px;font-size:.72rem;font-weight:850;background:#eef4f1;color:#355249}.badge.taken{background:#e4f7ed;color:#14683f}.badge.done{background:#eceff0;color:#53605a}.card{max-width:900px;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 12px 35px rgba(20,40,30,.05)}h1{margin:0 0 8px;font-size:1.65rem}.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:16px 0}.fact{padding:12px;border-radius:13px;background:#f7faf8}.fact b{display:block;font-size:.76rem;color:var(--muted);margin-bottom:4px}.photos{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:12px 0}.photos img{width:100%;height:140px;object-fit:cover;border-radius:13px;border:1px solid var(--line)}.chat{border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-top:18px}.messages{height:320px;overflow:auto;padding:14px;background:#f6f8f7}.msg{max-width:78%;padding:10px 12px;border-radius:14px;margin:7px 0;white-space:pre-wrap}.msg.in{background:white;border:1px solid var(--line)}.msg.out{background:#dff6e9;margin-left:auto}.composer{display:flex;gap:8px;padding:10px;background:white;border-top:1px solid var(--line)}.composer textarea{flex:1;min-height:44px;max-height:110px;resize:vertical;border:1px solid var(--line);border-radius:12px;padding:10px;font:inherit}.empty{padding:35px;text-align:center;color:var(--muted)}.error{padding:12px;border-radius:12px;background:#fff0f0;color:#a32525}.ok{padding:12px;border-radius:12px;background:#eaf8f0;color:#17643d}.hidden{display:none!important}@media(max-width:820px){.layout{grid-template-columns:1fr}.left{border-right:0;border-bottom:1px solid var(--line);max-height:42vh}.right{padding:12px}.facts{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="top"><div class="brand"><b>NEXIA</b> · Portal del reciclador</div><div id="topStatus" class="small" style="color:#cfe8db">Cargando…</div></div>
<div class="layout">
  <aside class="left">
    <div class="toolbar"><button id="refreshBtn" class="secondary">↻ Actualizar</button></div>
    <div id="list"><div class="empty">Cargando solicitudes…</div></div>
  </aside>
  <main class="right">
    <div id="empty" class="card empty">Selecciona una solicitud para ver sus detalles y conversar.</div>
    <div id="detail" class="card hidden"></div>
  </main>
</div>
<script>
const P=new URLSearchParams(location.search);
const token=P.get('token')||'';
const API=(P.get('api')||'https://chatbot-laortiga-hddw.onrender.com').replace(/\/$/,'');
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
let rows=[],selected=null,timer=null;
async function request(path,opt={}){const r=await fetch(API+path,{...opt,headers:{'Content-Type':'application/json',...(opt.headers||{})}});const d=await r.json().catch(()=>({}));if(!r.ok||d.ok===false)throw new Error(d.error||`Error ${r.status}`);return d}
function money(v){return v==null||v===''?'Sin aporte':'$'+Number(v).toLocaleString('es-CL')+' CLP'}
function stateBadge(x){const s=String(x||'').toLowerCase();return `<span class="badge ${s==='tomada'?'taken':(['cerrada','completada'].includes(s)?'done':'')}">${esc(s||'pendiente')}</span>`}
async function load(){if(!token){$('list').innerHTML='<div class="error">Enlace de acceso incompleto.</div>';return}try{$('topStatus').textContent='Actualizando…';const d=await request('/public/recicladores/solicitudes?token='+encodeURIComponent(token));rows=d.solicitudes||[];renderList();$('topStatus').textContent='Portal activo';if(selected){const still=rows.find(x=>x.id===selected);if(still)await openItem(still.id)}}catch(e){$('list').innerHTML=`<div class="error">${esc(e.message)}</div>`;$('topStatus').textContent='Error de acceso'}}
function renderList(){if(!rows.length){$('list').innerHTML='<div class="empty">No tienes solicitudes por ahora.</div>';return}$('list').innerHTML=rows.map(x=>{const s=x.solicitud||{};return `<div class="item ${selected===x.id?'active':''}" data-id="${esc(x.id)}"><div style="display:flex;justify-content:space-between;gap:8px"><h3>${esc(s.comuna||'Solicitud')}</h3>${stateBadge(x.estado)}</div><div class="small">${esc((s.tipos_producto||[]).join(', ')||'Material no indicado')}</div><div class="small">${esc(s.fecha_retiro||'Fecha a coordinar')} · ${esc(s.horario_retiro||'Horario a coordinar')}</div><div class="small" style="margin-top:5px"><b>${esc(money(s.monto_ofrecido))}</b></div></div>`}).join('');document.querySelectorAll('.item[data-id]').forEach(el=>el.onclick=()=>openItem(el.dataset.id))}
async function openItem(id){selected=id;renderList();$('empty').classList.add('hidden');$('detail').classList.remove('hidden');$('detail').innerHTML='<div class="empty">Cargando detalle…</div>';try{const d=await request('/public/recicladores/match/'+encodeURIComponent(id)+'?token='+encodeURIComponent(token));renderDetail(d)}catch(e){$('detail').innerHTML=`<div class="error">${esc(e.message)}</div>`}}
function renderDetail(d){const s=d.solicitud||{},m=d.match||{},chat=d.chat||null;const photos=(s.fotos||[]).filter(x=>x.url);const taken=String(m.estado||'').toLowerCase()==='tomada';const final=['completada','no_concretada','cancelada'].includes(String(s.estado||'').toLowerCase());$('detail').innerHTML=`<div style="display:flex;justify-content:space-between;gap:12px;align-items:start"><div><h1>${esc(s.comuna||'Solicitud de retiro')}</h1><div class="small">${esc((s.tipos_producto||[]).join(', '))}</div></div>${stateBadge(m.estado)}</div><div class="facts"><div class="fact"><b>Retiro</b>${esc(s.fecha_retiro||'A coordinar')} · ${esc(s.horario_retiro||'A coordinar')}</div><div class="fact"><b>Bultos</b>${esc(s.cantidad_bultos||1)}</div><div class="fact"><b>Aporte</b>${esc(money(s.monto_ofrecido))}</div><div class="fact"><b>Estado</b>${esc(s.estado||'disponible')}</div></div>${photos.length?`<h3>Fotos del material</h3><div class="photos">${photos.map(x=>`<a href="${esc(x.url)}" target="_blank"><img src="${esc(x.url)}" alt="Material"></a>`).join('')}</div>`:''}${taken?`<div class="ok"><b>Datos del retiro</b><br>${esc(s.nombre||'')} ${esc(s.apellido||'')}<br>${esc(s.direccion_retiro||'')}<br>${s.telefono?'WhatsApp: +'+esc(s.telefono):''}</div>`:''}${!taken&&!final?`<div style="margin-top:16px"><button id="takeBtn">Tomar solicitud</button></div>`:''}<div id="actionMsg"></div>${taken?chatHtml(chat,final):''}`;if($('takeBtn'))$('takeBtn').onclick=take;if(taken)bindChat(chat,final)}
function chatHtml(chat,final){const ms=chat?.mensajes||[];const enabled=!!chat?.habilitado&&!final;return `<div class="chat"><div style="padding:12px 14px;background:white"><b>Conversación con la persona</b><div class="small">${enabled?'Puedes coordinar el retiro desde aquí.':'El chat no está disponible en este momento.'}</div></div><div id="messages" class="messages">${ms.map(renderMsg).join('')||'<div class="empty">Aún no hay mensajes.</div>'}</div><div class="composer ${enabled?'':'hidden'}"><textarea id="messageText" placeholder="Escribe un mensaje…"></textarea><button id="sendBtn">Enviar</button></div></div>`}
function renderMsg(x){return `<div class="msg ${x.direccion==='entrante'?'in':'out'}">${esc(x.mensaje||'')}<div class="small" style="margin-top:4px">${esc(new Date(x.fecha).toLocaleString('es-CL'))}</div></div>`}
function bindChat(chat,final){if($('messages'))$('messages').scrollTop=$('messages').scrollHeight;if($('sendBtn'))$('sendBtn').onclick=sendMessage;if($('messageText'))$('messageText').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage()}})}
async function take(){try{$('takeBtn').disabled=true;const d=await request('/public/recicladores/match/'+encodeURIComponent(selected)+'/tomar',{method:'POST',body:JSON.stringify({token})});$('actionMsg').innerHTML=`<div class="ok" style="margin-top:12px">${esc(d.mensaje||'Solicitud adjudicada')}</div>`;await load();await openItem(selected)}catch(e){$('actionMsg').innerHTML=`<div class="error" style="margin-top:12px">${esc(e.message)}</div>`}finally{if($('takeBtn'))$('takeBtn').disabled=false}}
async function sendMessage(){const t=$('messageText'),msg=t?.value.trim();if(!msg)return;try{$('sendBtn').disabled=true;await request('/public/recicladores/match/'+encodeURIComponent(selected)+'/mensaje',{method:'POST',body:JSON.stringify({token,mensaje:msg})});t.value='';await openItem(selected)}catch(e){alert(e.message)}finally{if($('sendBtn'))$('sendBtn').disabled=false}}
$('refreshBtn').onclick=load;
load();timer=setInterval(()=>{if(document.visibilityState==='visible')load()},30000);
</script>
</body>
</html>
